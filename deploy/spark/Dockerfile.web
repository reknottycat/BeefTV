# syntax=docker/dockerfile:1.7
FROM oven/bun:1.3.13 AS web-build
WORKDIR /app/web
ARG BUILD_VERSION
ENV CANVAS_BUILD_VERSION=${BUILD_VERSION} BEEFTV_FULL_MEDIA_RESOURCES=0 VITE_CANVAS_LOCAL_RESOURCE_STORE=backend VITE_CANVAS_LOCAL_MODE=true
COPY web/package.json web/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --ignore-scripts --frozen-lockfile --cache-dir=/root/.bun/install/cache
COPY VERSION CHANGELOG.md README.md /app/
COPY assets /app/assets
COPY backend/internal/providerpreset/video_contracts.json /app/backend/internal/providerpreset/video_contracts.json
COPY web ./
RUN bun run build:slim

FROM nginx:1.27-alpine
ARG BUILD_COMMIT=unknown
ARG SOURCE_REPOSITORY=https://github.com/glanderness/BeefTV
LABEL org.opencontainers.image.source=${SOURCE_REPOSITORY} \
      org.opencontainers.image.revision=${BUILD_COMMIT}
COPY --from=web-build /app/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/spark/nginx-local-comfy.conf /etc/nginx/local-comfy.conf
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/doc/beeftv/
# Preserve the upstream gateway and add one narrow local adapter route.
RUN sed -i '/server_name _;/a\    include /etc/nginx/local-comfy.conf;' /etc/nginx/conf.d/default.conf
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
