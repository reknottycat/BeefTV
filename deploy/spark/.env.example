# Copy into a gitignored .local directory and use --env-file explicitly.
# Example values below are placeholders; never commit the real host or paths.
BEEFTV_COMPOSE_PROJECT=beeftv-spark
BEEFTV_RELEASE=commit-REPLACE_WITH_TESTED_SHA
BEEFTV_COMMIT=REPLACE_WITH_FULL_TESTED_SOURCE_COMMIT
BEEFTV_SOURCE_REPOSITORY=https://github.com/YOUR_ACCOUNT/BeefTV
BEEFTV_BUILD_TIME=unknown
BEEFTV_VERSION=
BEEFTV_BIND_ADDRESS=127.0.0.1
BEEFTV_PORT=8190
BEEFTV_ORIGIN=http://127.0.0.1:8190
BEEFTV_RUN_UID=1000
BEEFTV_RUN_GID=1000
BEEFTV_BACKEND_DATA=/srv/beeftv-private/backend-data
BEEFTV_COMFY_STATE=/srv/beeftv-private/comfy-state
BEEFTV_COMFY_RECIPES_DIR=/srv/beeftv-private/recipes
BEEFTV_COMFY_URL=http://comfyui.local:8188
BEEFTV_COMFY_ENABLE_GENERATION=0
BEEFTV_AUTO_MIGRATE=true
BEEFTV_CLOUD_PRIVATE_HOSTS=
GOPROXY=https://proxy.golang.org,direct
